# Copy to .env, chmod 600 .env, set every secret before starting.
DEBUG=0
# Use 1 only in isolated local demo with DEBUG=1 and PAYMENT_PROVIDER=mock.
DEMO_MODE=0
SECRET_KEY=
POSTGRES_DB=arkham
POSTGRES_USER=arkham_owner
POSTGRES_PASSWORD=
POSTGRES_APP_USER=arkham_app
POSTGRES_APP_PASSWORD=
ALLOWED_HOSTS=arkham.ir,www.arkham.ir,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://arkham.ir,https://www.arkham.ir
PUBLIC_ORIGIN=https://arkham.ir
HTTP_PORT=8088
PAYMENT_PROVIDER=disabled
ZARINPAL_MERCHANT_ID=
